# ─────────────────────────────────────────────────────────────
# plot twist. environment configuration
# Copy to .env.local for local development. Never commit real values.
# All secrets are read server-side only (src/lib/env.ts).
# ─────────────────────────────────────────────────────────────

# Public URL of the app (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database + authentication (Supabase) ─────────────────────
# Without these the app uses a local file store (.data/) and a signed-cookie dev sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated email domains allowed to sign in, e.g. scapia.cards
ALLOWED_EMAIL_DOMAINS=
# Comma-separated emails that become admins on first sign-in (the first user is always admin)
ADMIN_EMAILS=
# Long random string; signs local dev sessions. Required if local sign-in is used outside development.
SESSION_SECRET=

# ── AI (OpenAI, server-side only) ────────────────────────────
OPENAI_API_KEY=
# Analytical model (research extraction, classification). Admins can override in /admin.
OPENAI_MODEL=gpt-5-mini
# Creative model (campaign generation, refinement, pitches)
OPENAI_CREATIVE_MODEL=gpt-5

# ── Web search (one required for live research, news search and contacts) ──
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Photography (Wikimedia Commons works with no key) ────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── Scheduled jobs ───────────────────────────────────────────
# Bearer token Vercel Cron sends to /api/cron/* (set the same value in Vercel)
CRON_SECRET=

# ── Local development only ───────────────────────────────────
# true = offline, clearly-labelled DEMO fixtures replace AI + search so workflows can be tested
# without API keys. Ignored in production builds.
PLOT_TWIST_DEMO_FIXTURES=false
# Where the local file store lives (default .data)
PLOT_TWIST_DATA_DIR=.data
